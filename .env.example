# Telegram bot credentials
BOT_TOKEN=your_bot_token
ADMIN_IDS=123456789

# Telegram API credentials: https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PROXY=

# Bot settings
BOT_PARSE_MODE=HTML
DATA_DIR=storage
SESSIONS_DIR=storage/sessions
JSON_DIR=storage/json
TEMP_DIR=storage/tmp
DB_PATH=storage/bot.sqlite3

# Telegram Desktop profile defaults
DEFAULT_LANG_CODE=en
DEFAULT_SYSTEM_LANG_CODE=en-US
DEFAULT_LANG_PACK=tdesktop
TRIGGER_CHAT_ID=-1001234567890
